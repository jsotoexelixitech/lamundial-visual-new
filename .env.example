# ─── Nexus (120 IP o cierrelmds HTTPS) ───
# IP srv001:
# VITE_NEXUS_API_URL=http://192.168.8.120:3092
# HTTPS cierre:
VITE_NEXUS_API_URL=https://cierrelmds.exelixitech.com/nexus-api

# ─── Módulos (misma convención: IP :5181–5184 o cierrelmds) ───
# VITE_PORTAL_OCR_URL=http://192.168.8.120:5181/
VITE_PORTAL_OCR_URL=https://cierrelmds.exelixitech.com/ocr/
VITE_PORTAL_EMISION_URL=https://cierrelmds.exelixitech.com/emision/
VITE_PORTAL_FORM_URL=https://cierrelmds.exelixitech.com/formulario/
VITE_PORTAL_PAGOS_URL=https://cierrelmds.exelixitech.com/pagos/

# Apache /portal/ → VITE_APP_BASE=/portal/ · IP :5190 directo → /
VITE_APP_BASE=/

# Metadata SSO La Mundial (POST /api/auth/sso-delegate)
VITE_SSO_CPRODUCTOR=80080
VITE_SSO_CUSUARIO=4
VITE_SSO_CENTIDAD=P
VITE_SSO_CITEM=80080
VITE_LAMUNDIAL_RAMO_PATRIMONIAL=20
